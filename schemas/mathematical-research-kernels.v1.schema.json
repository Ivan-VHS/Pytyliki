{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://pytyliki.invalid/schemas/mathematical-research-kernels.v1.schema.json",
  "title": "Pytyliki Mathematical Research Kernel Manifest v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "version",
    "owner",
    "contract_schema",
    "execution_performed",
    "functions"
  ],
  "properties": {
    "schema": {
      "const": "pytyliki.mathematical-research-kernels.v1"
    },
    "version": {
      "const": "1.0.0"
    },
    "owner": {
      "const": "Pytyliki"
    },
    "contract_schema": {
      "const": "reaper.mathematical-research-contracts.v1"
    },
    "execution_performed": {
      "const": false
    },
    "functions": {
      "type": "array",
      "minItems": 51,
      "maxItems": 51,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "api"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]*\\.[a-z0-9_]+$"
          },
          "api": {
            "type": "string",
            "pattern": "^pl_math_[a-z0-9_]+$"
          }
        }
      }
    }
  }
}
