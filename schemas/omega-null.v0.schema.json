{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Ivan-VHS/Pytyliki/blob/main/schemas/omega-null.v0.schema.json",
  "title": "Pytyliki Omega-Null Research Profile v0",
  "description": "Physics-inspired experimental profile with explicit model, artifact and physical-target boundaries.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "profile",
    "ownership",
    "semantic_layers",
    "marker_semantics",
    "operation_catalog",
    "frameworks",
    "claim_translation",
    "evidence_policy",
    "access_model",
    "research_domains",
    "engineering_practices"
  ],
  "properties": {
    "schema": {
      "const": "pytyliki.omega-null.v0"
    },
    "profile": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "display_name",
        "parent",
        "version",
        "maturity",
        "grammar_status",
        "compiler_owner",
        "domain_owner",
        "purpose",
        "non_goals"
      ],
      "properties": {
        "id": {
          "const": "omega-null"
        },
        "display_name": {
          "const": "Omega-Null"
        },
        "parent": {
          "const": "pytyliki.iron-core"
        },
        "version": {
          "type": "string",
          "pattern": "^\\d+\\.\\d+\\.\\d+-research$"
        },
        "maturity": {
          "const": "research_profile"
        },
        "grammar_status": {
          "enum": [
            "illustrative_not_implemented",
            "parser_prototype",
            "reaper_frontend_checked"
          ]
        },
        "compiler_owner": {
          "const": "reaper"
        },
        "domain_owner": {
          "const": "pytyliki"
        },
        "purpose": {
          "type": "string",
          "minLength": 80
        },
        "non_goals": {
          "type": "array",
          "minItems": 4,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 20
          }
        }
      }
    },
    "ownership": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "reaper",
        "pytyliki",
        "dak_os",
        "board_and_lab_backends"
      ],
      "properties": {
        "reaper": {
          "type": "string",
          "minLength": 50
        },
        "pytyliki": {
          "type": "string",
          "minLength": 40
        },
        "dak_os": {
          "type": "string",
          "minLength": 40
        },
        "board_and_lab_backends": {
          "type": "string",
          "minLength": 40
        }
      }
    },
    "semantic_layers": {
      "type": "array",
      "minItems": 5,
      "maxItems": 5,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "name",
          "scope",
          "execution"
        ],
        "properties": {
          "id": {
            "enum": [
              "O0",
              "O1",
              "O2",
              "O3",
              "O4"
            ]
          },
          "name": {
            "type": "string",
            "minLength": 3
          },
          "scope": {
            "type": "string",
            "minLength": 10
          },
          "execution": {
            "type": "string",
            "minLength": 10
          }
        }
      }
    },
    "marker_semantics": {
      "type": "array",
      "minItems": 20,
      "maxItems": 20,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "marker",
          "normalized",
          "category",
          "intent",
          "semantics",
          "forbidden_interpretation"
        ],
        "properties": {
          "marker": {
            "type": "string",
            "minLength": 3
          },
          "normalized": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_.]*$"
          },
          "category": {
            "type": "string",
            "minLength": 3
          },
          "intent": {
            "type": "string",
            "minLength": 10
          },
          "semantics": {
            "type": "string",
            "minLength": 20
          },
          "forbidden_interpretation": {
            "type": "string",
            "minLength": 10
          }
        }
      }
    },
    "operation_catalog": {
      "type": "array",
      "minItems": 12,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "target",
          "mode",
          "effect",
          "semantics",
          "result",
          "status",
          "constraints",
          "required_capability",
          "operator_approval_required"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_.]*$"
          },
          "target": {
            "type": "string",
            "minLength": 3
          },
          "mode": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "enum": [
                "inspect",
                "plan",
                "simulate",
                "verify",
                "target"
              ]
            }
          },
          "effect": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 3
            }
          },
          "semantics": {
            "type": "string",
            "minLength": 20
          },
          "result": {
            "type": "string",
            "minLength": 3
          },
          "status": {
            "enum": [
              "research",
              "planned",
              "partial",
              "implemented"
            ]
          },
          "constraints": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "minLength": 10
            }
          },
          "required_capability": {
            "type": "string",
            "minLength": 1
          },
          "operator_approval_required": {
            "type": "boolean"
          }
        }
      }
    },
    "frameworks": {
      "type": "array",
      "minItems": 4,
      "maxItems": 4,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "role",
          "components"
        ],
        "properties": {
          "id": {
            "enum": [
              "aegis-shield",
              "chrono-weave",
              "matter-forge",
              "mind-link"
            ]
          },
          "role": {
            "type": "string",
            "minLength": 10
          },
          "components": {
            "type": "array",
            "minItems": 3,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "name",
                "mapping"
              ],
              "properties": {
                "name": {
                  "type": "string",
                  "minLength": 3
                },
                "mapping": {
                  "type": "string",
                  "minLength": 20
                }
              }
            }
          }
        }
      }
    },
    "claim_translation": {
      "type": "array",
      "minItems": 9,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "claim",
          "classification",
          "translation"
        ],
        "properties": {
          "claim": {
            "type": "string",
            "minLength": 10
          },
          "classification": {
            "type": "string",
            "minLength": 5
          },
          "translation": {
            "type": "string",
            "minLength": 20
          }
        }
      }
    },
    "evidence_policy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "modes",
        "required_fields",
        "invariants"
      ],
      "properties": {
        "modes": {
          "type": "array",
          "minItems": 8,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 5
          }
        },
        "required_fields": {
          "type": "array",
          "minItems": 10,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 3
          }
        },
        "invariants": {
          "type": "array",
          "minItems": 7,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 20
          }
        }
      }
    },
    "access_model": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "default_mode",
        "allowed_modes",
        "deny_by_default",
        "no_implicit_hardware_access",
        "no_hidden_network",
        "no_automatic_firmware_or_driver_install",
        "no_reality_mutation_api"
      ],
      "properties": {
        "default_mode": {
          "const": "inspect"
        },
        "allowed_modes": {
          "type": "array",
          "minItems": 7,
          "uniqueItems": true
        },
        "deny_by_default": {
          "const": true
        },
        "no_implicit_hardware_access": {
          "const": true
        },
        "no_hidden_network": {
          "const": true
        },
        "no_automatic_firmware_or_driver_install": {
          "const": true
        },
        "no_reality_mutation_api": {
          "const": true
        }
      }
    },
    "research_domains": {
      "type": "array",
      "minItems": 9,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "module",
          "meaning"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_.]*$"
          },
          "module": {
            "type": "string",
            "pattern": "^pyty\\.[a-z][a-z0-9.-]*$"
          },
          "meaning": {
            "type": "string",
            "minLength": 20
          }
        }
      }
    },
    "engineering_practices": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "verification_gates",
        "resource_control",
        "state_backup",
        "forecast_policy"
      ],
      "properties": {
        "verification_gates": {
          "type": "array",
          "minItems": 3,
          "maxItems": 3,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "name",
              "purpose"
            ],
            "properties": {
              "id": {
                "enum": [
                  "syntax_type_effect",
                  "model_invariants",
                  "physical_target_qualification"
                ]
              },
              "name": {
                "type": "string",
                "minLength": 5
              },
              "purpose": {
                "type": "string",
                "minLength": 20
              }
            }
          }
        },
        "resource_control": {
          "type": "string",
          "minLength": 30
        },
        "state_backup": {
          "type": "string",
          "minLength": 30
        },
        "forecast_policy": {
          "type": "string",
          "minLength": 30
        }
      }
    }
  }
}
