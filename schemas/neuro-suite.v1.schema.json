{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:ivan-vhs:pytyliki:neuro-suite:v1",
  "title": "Pytyliki Neural Framework Suite v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "version",
    "repository",
    "runtime",
    "limits",
    "frameworks",
    "contract_flags",
    "implemented_features",
    "conceptual_matrix",
    "not_claimed",
    "safety_boundaries"
  ],
  "properties": {
    "schema": {
      "const": "pytyliki.neuro-suite.v1"
    },
    "version": {
      "const": 1
    },
    "repository": {
      "const": "Ivan-VHS/Pytyliki"
    },
    "runtime": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "language",
        "numeric_type",
        "model_kind",
        "weight_layout",
        "activations",
        "memory_policy",
        "execution_policy"
      ],
      "properties": {
        "language": {
          "const": "C11"
        },
        "numeric_type": {
          "type": "string",
          "minLength": 1
        },
        "model_kind": {
          "type": "string",
          "minLength": 1
        },
        "weight_layout": {
          "type": "string",
          "minLength": 1
        },
        "activations": {
          "type": "array",
          "minItems": 4,
          "uniqueItems": true,
          "items": {
            "enum": [
              "linear",
              "relu",
              "tanh",
              "sigmoid"
            ]
          }
        },
        "memory_policy": {
          "type": "string",
          "minLength": 1
        },
        "execution_policy": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "limits": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "max_layers",
        "max_neurons_per_layer",
        "max_parameters",
        "max_batch",
        "max_peers",
        "max_peer_id_ascii_bytes",
        "max_learning_rate"
      ],
      "properties": {
        "max_layers": {
          "const": 32
        },
        "max_neurons_per_layer": {
          "const": 4096
        },
        "max_parameters": {
          "const": 4194304
        },
        "max_batch": {
          "const": 1024
        },
        "max_peers": {
          "const": 32
        },
        "max_peer_id_ascii_bytes": {
          "const": 64
        },
        "max_learning_rate": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 1
        }
      }
    },
    "frameworks": {
      "type": "array",
      "minItems": 6,
      "maxItems": 6,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "name",
          "neural_model",
          "contract",
          "discipline",
          "implemented_api"
        ],
        "properties": {
          "id": {
            "enum": [
              "sokk",
              "above-al",
              "jumpju",
              "diogo",
              "ghostery",
              "selitol"
            ]
          },
          "name": {
            "type": "string",
            "minLength": 1
          },
          "neural_model": {
            "type": "string",
            "minLength": 1
          },
          "contract": {
            "type": "string",
            "minLength": 1
          },
          "discipline": {
            "type": "string",
            "minLength": 1
          },
          "implemented_api": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "pattern": "^pl_neuro_[a-z0-9_]+$"
            }
          }
        }
      }
    },
    "contract_flags": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "implemented_features": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "conceptual_matrix": {
      "type": "array",
      "minItems": 20,
      "maxItems": 20,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "framework",
          "neural_system",
          "contract",
          "engineering"
        ],
        "properties": {
          "framework": {
            "enum": [
              "Sokk",
              "Above AL",
              "Jumpju",
              "Diogo",
              "Ghostery",
              "SELITOL"
            ]
          },
          "neural_system": {
            "type": "string",
            "minLength": 1
          },
          "contract": {
            "type": "string",
            "minLength": 1
          },
          "engineering": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "not_claimed": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "safety_boundaries": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    }
  }
}
