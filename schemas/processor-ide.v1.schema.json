{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Ivan-VHS/Pytyliki/blob/main/schemas/processor-ide.v1.schema.json",
  "title": "Pytyliki Processor IDE Contract v1",
  "description": "Machine-readable requirements, workspace taxonomy, target/session model, evidence policy and safety rules for the Pytyliki Processor IDE.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "project",
    "baseline",
    "ownership",
    "related_contracts",
    "workspaces",
    "shell",
    "target_model",
    "evidence",
    "safety",
    "rule_status_legend",
    "rules",
    "implementation_layers",
    "integration_workstreams",
    "safety_adjustments",
    "perspectives"
  ],
  "properties": {
    "schema": {
      "const": "pytyliki.processor-ide.v1"
    },
    "project": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "name",
        "repository",
        "version",
        "created",
        "purpose"
      ],
      "properties": {
        "id": {
          "const": "processor-ide"
        },
        "name": {
          "type": "string",
          "minLength": 5
        },
        "repository": {
          "const": "Ivan-VHS/Pytyliki"
        },
        "version": {
          "type": "string",
          "pattern": "^\\d+\\.\\d+\\.\\d+$"
        },
        "created": {
          "type": "string",
          "format": "date"
        },
        "purpose": {
          "type": "string",
          "minLength": 40
        }
      }
    },
    "baseline": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "branch",
        "commit",
        "reviewed_at",
        "current_product_boundary",
        "rule_count",
        "default_status"
      ],
      "properties": {
        "branch": {
          "const": "main"
        },
        "commit": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        },
        "reviewed_at": {
          "type": "string",
          "format": "date"
        },
        "current_product_boundary": {
          "type": "string",
          "minLength": 100
        },
        "rule_count": {
          "const": 100
        },
        "default_status": {
          "const": "planned"
        }
      }
    },
    "ownership": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "pytyliki",
        "reaper",
        "duck_os",
        "board_and_vendor_backends"
      ],
      "properties": {
        "pytyliki": {
          "type": "string",
          "minLength": 30
        },
        "reaper": {
          "type": "string",
          "minLength": 30
        },
        "duck_os": {
          "type": "string",
          "minLength": 30
        },
        "board_and_vendor_backends": {
          "type": "string",
          "minLength": 30
        }
      }
    },
    "related_contracts": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "iron_core",
        "low_level_contract",
        "system_workspace_registry"
      ],
      "properties": {
        "iron_core": {
          "type": "string",
          "minLength": 1
        },
        "low_level_contract": {
          "type": "string",
          "minLength": 1
        },
        "system_workspace_registry": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "header",
            "source",
            "tests",
            "existing_count",
            "reuse_policy"
          ],
          "properties": {
            "header": {
              "type": "string",
              "minLength": 1
            },
            "source": {
              "type": "string",
              "minLength": 1
            },
            "tests": {
              "type": "string",
              "minLength": 1
            },
            "existing_count": {
              "const": 20
            },
            "reuse_policy": {
              "type": "string",
              "minLength": 50
            }
          }
        }
      }
    },
    "workspaces": {
      "type": "array",
      "minItems": 20,
      "maxItems": 20,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "name",
          "domain",
          "responsibility",
          "source_registry",
          "source_enum",
          "registry_status",
          "ide_workspace_status",
          "description"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
          },
          "name": {
            "type": "string",
            "minLength": 3
          },
          "domain": {
            "type": "string",
            "minLength": 3
          },
          "responsibility": {
            "type": "string",
            "minLength": 10
          },
          "source_registry": {
            "type": "string",
            "minLength": 1
          },
          "source_enum": {
            "type": "string",
            "minLength": 1
          },
          "registry_status": {
            "const": "implemented"
          },
          "ide_workspace_status": {
            "enum": [
              "planned",
              "partial",
              "implemented"
            ]
          },
          "description": {
            "type": "string",
            "minLength": 20
          }
        }
      }
    },
    "shell": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "product_mode",
        "default_mode",
        "panes",
        "selection_rule"
      ],
      "properties": {
        "product_mode": {
          "const": "single_target_aware_processor_ide"
        },
        "default_mode": {
          "const": "inspect"
        },
        "panes": {
          "type": "array",
          "minItems": 10,
          "maxItems": 10,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "purpose"
            ],
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[a-z0-9_]+$"
              },
              "purpose": {
                "type": "string",
                "minLength": 20
              }
            }
          }
        },
        "selection_rule": {
          "type": "string",
          "minLength": 40
        }
      }
    },
    "target_model": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "required_identity",
        "optional_identity",
        "unknown_policy",
        "modes"
      ],
      "properties": {
        "required_identity": {
          "type": "array",
          "minItems": 5,
          "uniqueItems": true,
          "items": {
            "type": "string"
          }
        },
        "optional_identity": {
          "type": "array",
          "minItems": 5,
          "uniqueItems": true,
          "items": {
            "type": "string"
          }
        },
        "unknown_policy": {
          "type": "string",
          "minLength": 50
        },
        "modes": {
          "type": "array",
          "minItems": 7,
          "maxItems": 7,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "mutation",
              "description"
            ],
            "properties": {
              "id": {
                "enum": [
                  "inspect",
                  "plan",
                  "static",
                  "simulate",
                  "debug",
                  "hardware_in_loop",
                  "privileged"
                ]
              },
              "mutation": {
                "oneOf": [
                  {
                    "type": "boolean"
                  },
                  {
                    "enum": [
                      "provider-dependent",
                      "capability-gated"
                    ]
                  }
                ]
              },
              "description": {
                "type": "string",
                "minLength": 10
              }
            }
          }
        }
      }
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "modes",
        "quality",
        "required_fields",
        "invariants"
      ],
      "properties": {
        "modes": {
          "type": "array",
          "minItems": 8,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 3
          }
        },
        "quality": {
          "type": "array",
          "minItems": 5,
          "uniqueItems": true,
          "items": {
            "type": "string"
          }
        },
        "required_fields": {
          "type": "array",
          "minItems": 10,
          "uniqueItems": true,
          "items": {
            "type": "string"
          }
        },
        "invariants": {
          "type": "array",
          "minItems": 7,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 20
          }
        }
      }
    },
    "safety": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "default_mode",
        "deny_by_default",
        "no_implicit_hardware_access",
        "no_hidden_tool_invocation",
        "no_automatic_driver_firmware_install",
        "no_unreviewed_mmio_or_privileged_write",
        "no_secret_logging",
        "no_silent_source_rewrite"
      ],
      "properties": {
        "default_mode": {
          "const": "inspect"
        },
        "deny_by_default": {
          "const": true
        },
        "no_implicit_hardware_access": {
          "const": true
        },
        "no_hidden_tool_invocation": {
          "const": true
        },
        "no_automatic_driver_firmware_install": {
          "const": true
        },
        "no_unreviewed_mmio_or_privileged_write": {
          "const": true
        },
        "no_secret_logging": {
          "const": true
        },
        "no_silent_source_rewrite": {
          "const": true
        }
      }
    },
    "rule_status_legend": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "partial",
        "planned",
        "research"
      ],
      "properties": {
        "partial": {
          "type": "string",
          "minLength": 20
        },
        "planned": {
          "type": "string",
          "minLength": 20
        },
        "research": {
          "type": "string",
          "minLength": 20
        }
      }
    },
    "rules": {
      "type": "array",
      "minItems": 100,
      "maxItems": 100,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "group",
          "title",
          "workspace",
          "requirement",
          "acceptance",
          "interpretation_adjustment",
          "status",
          "evidence"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^PIDE-[0-9]{3}$"
          },
          "group": {
            "enum": [
              "IDE_CORE",
              "SILICON_DEPTH"
            ]
          },
          "title": {
            "type": "string",
            "minLength": 3
          },
          "workspace": {
            "type": "string",
            "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
          },
          "requirement": {
            "type": "string",
            "minLength": 20
          },
          "acceptance": {
            "type": "string",
            "minLength": 20
          },
          "interpretation_adjustment": {
            "type": [
              "string",
              "null"
            ]
          },
          "status": {
            "enum": [
              "partial",
              "planned",
              "research",
              "implemented"
            ]
          },
          "evidence": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "uniqueItems": true
          }
        }
      }
    },
    "implementation_layers": {
      "type": "array",
      "minItems": 8,
      "maxItems": 8,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "name",
          "gate"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^IDE-[0-7]$"
          },
          "name": {
            "type": "string",
            "minLength": 3
          },
          "gate": {
            "type": "string",
            "minLength": 20
          }
        }
      }
    },
    "integration_workstreams": {
      "type": "array",
      "minItems": 8,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "pr",
          "title",
          "relation"
        ],
        "properties": {
          "pr": {
            "type": "integer",
            "minimum": 1
          },
          "title": {
            "type": "string",
            "minLength": 3
          },
          "relation": {
            "type": "string",
            "minLength": 20
          }
        }
      }
    },
    "safety_adjustments": {
      "type": "array",
      "minItems": 5,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 30
      }
    },
    "perspectives": {
      "type": "array",
      "minItems": 20,
      "maxItems": 20,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "display_name",
          "category",
          "qualifier",
          "focus",
          "workspace",
          "scope_kind",
          "authority",
          "status"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
          },
          "display_name": {
            "type": "string",
            "minLength": 10
          },
          "category": {
            "type": "string",
            "minLength": 3
          },
          "qualifier": {
            "type": "string",
            "minLength": 3
          },
          "focus": {
            "type": "string",
            "minLength": 20
          },
          "workspace": {
            "type": "string",
            "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
          },
          "scope_kind": {
            "const": "workspace_perspective"
          },
          "authority": {
            "const": "no_privilege_elevation"
          },
          "status": {
            "enum": [
              "planned",
              "partial",
              "implemented"
            ]
          }
        }
      }
    }
  }
}
