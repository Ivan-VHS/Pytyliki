{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://pytyliki.dev/schemas/pytyliki.processor-topology-evidence.v2.schema.json",
  "title": "Pytyliki Processor Topology Evidence v2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "version",
    "generation",
    "captured_at",
    "collector",
    "completeness",
    "topology",
    "isa"
  ],
  "properties": {
    "schema": {
      "const": "pytyliki.processor-topology-evidence.v2"
    },
    "version": {
      "const": 2
    },
    "generation": {
      "type": "integer",
      "minimum": 1
    },
    "captured_at": {
      "type": "string",
      "format": "date-time"
    },
    "collector": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "provider",
        "interface",
        "read_only"
      ],
      "properties": {
        "provider": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        },
        "interface": {
          "enum": [
            "windows-processor-topology-api",
            "linux-sysfs",
            "cpuid",
            "fixture",
            "caller-snapshot"
          ]
        },
        "read_only": {
          "const": true
        },
        "platform_release": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 96
        }
      }
    },
    "completeness": {
      "enum": [
        "complete",
        "partial",
        "unknown"
      ]
    },
    "topology": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "logical_processor_count",
        "online_logical_processor_count",
        "logical_processors",
        "caches",
        "numa_nodes"
      ],
      "properties": {
        "logical_processor_count": {
          "type": "integer",
          "minimum": 1,
          "maximum": 4096
        },
        "online_logical_processor_count": {
          "type": "integer",
          "minimum": 0,
          "maximum": 4096
        },
        "logical_processors": {
          "type": "array",
          "minItems": 1,
          "maxItems": 4096,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "logical_id",
              "os_id",
              "online",
              "package_id",
              "die_id",
              "core_id",
              "numa_node_id",
              "evidence"
            ],
            "properties": {
              "logical_id": {
                "type": "integer",
                "minimum": 0,
                "maximum": 4095
              },
              "os_id": {
                "type": "integer",
                "minimum": 0,
                "maximum": 65535
              },
              "group_id": {
                "type": [
                  "integer",
                  "null"
                ],
                "minimum": 0,
                "maximum": 255
              },
              "online": {
                "type": "boolean"
              },
              "package_id": {
                "type": [
                  "integer",
                  "null"
                ],
                "minimum": 0
              },
              "die_id": {
                "type": [
                  "integer",
                  "null"
                ],
                "minimum": 0
              },
              "core_id": {
                "type": [
                  "integer",
                  "null"
                ],
                "minimum": 0
              },
              "numa_node_id": {
                "type": [
                  "integer",
                  "null"
                ],
                "minimum": 0
              },
              "evidence": {
                "enum": [
                  "observed",
                  "partially-observed",
                  "unknown"
                ]
              }
            }
          }
        },
        "caches": {
          "type": "array",
          "maxItems": 16384,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "cache_id",
              "level",
              "kind",
              "size_bytes",
              "line_bytes",
              "sharing_logical_ids",
              "evidence"
            ],
            "properties": {
              "cache_id": {
                "type": "integer",
                "minimum": 0
              },
              "level": {
                "type": "integer",
                "minimum": 1,
                "maximum": 4
              },
              "kind": {
                "enum": [
                  "data",
                  "instruction",
                  "unified",
                  "trace",
                  "unknown"
                ]
              },
              "size_bytes": {
                "type": [
                  "integer",
                  "null"
                ],
                "minimum": 1
              },
              "line_bytes": {
                "type": [
                  "integer",
                  "null"
                ],
                "minimum": 1
              },
              "sharing_logical_ids": {
                "type": "array",
                "uniqueItems": true,
                "maxItems": 4096,
                "items": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 4095
                }
              },
              "evidence": {
                "enum": [
                  "observed",
                  "partially-observed",
                  "unknown"
                ]
              }
            }
          }
        },
        "numa_nodes": {
          "type": "array",
          "maxItems": 1024,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "node_id",
              "logical_ids",
              "memory_total_bytes",
              "memory_available_bytes",
              "evidence"
            ],
            "properties": {
              "node_id": {
                "type": "integer",
                "minimum": 0
              },
              "logical_ids": {
                "type": "array",
                "uniqueItems": true,
                "maxItems": 4096,
                "items": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 4095
                }
              },
              "memory_total_bytes": {
                "type": [
                  "integer",
                  "null"
                ],
                "minimum": 1
              },
              "memory_available_bytes": {
                "type": [
                  "integer",
                  "null"
                ],
                "minimum": 0
              },
              "evidence": {
                "enum": [
                  "observed",
                  "partially-observed",
                  "unknown"
                ]
              }
            }
          }
        }
      }
    },
    "isa": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "architecture",
        "vendor",
        "model",
        "features"
      ],
      "properties": {
        "architecture": {
          "type": "string",
          "minLength": 1,
          "maxLength": 32
        },
        "vendor": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 32
        },
        "model": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 96
        },
        "features": {
          "type": "object",
          "additionalProperties": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "hardware_present",
              "os_usable",
              "evidence"
            ],
            "properties": {
              "hardware_present": {
                "type": [
                  "boolean",
                  "null"
                ]
              },
              "os_usable": {
                "type": [
                  "boolean",
                  "null"
                ]
              },
              "evidence": {
                "enum": [
                  "cpuid",
                  "os-api",
                  "os-state",
                  "platform-feature-query",
                  "unknown"
                ]
              }
            }
          }
        }
      }
    },
    "execution_performed": {
      "const": false
    },
    "hardware_access_performed": {
      "const": false
    },
    "processor_state_changed": {
      "const": false
    }
  }
}
