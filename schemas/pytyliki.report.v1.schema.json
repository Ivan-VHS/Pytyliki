{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Ivan-VHS/Pytyliki/blob/main/schemas/pytyliki.report.v1.schema.json",
  "title": "Pytyliki processor profile and suite report v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "program",
    "profile",
    "suite"
  ],
  "properties": {
    "schema": {
      "const": "pytyliki.report.v1"
    },
    "program": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "version"
      ],
      "properties": {
        "name": {
          "const": "Pytyliki"
        },
        "version": {
          "type": "string",
          "minLength": 1,
          "maxLength": 32
        }
      }
    },
    "profile": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "architecture",
        "cpu",
        "vendor",
        "logical_processors",
        "family",
        "model_id",
        "physical_memory_mib",
        "available_memory_mib",
        "isa"
      ],
      "properties": {
        "architecture": {
          "type": "string",
          "minLength": 1,
          "maxLength": 32
        },
        "cpu": {
          "type": "string",
          "minLength": 1,
          "maxLength": 96
        },
        "vendor": {
          "type": "string",
          "minLength": 1,
          "maxLength": 32
        },
        "logical_processors": {
          "type": "integer",
          "minimum": 1,
          "maximum": 4096
        },
        "family": {
          "type": "integer",
          "minimum": 0,
          "maximum": 4294967295
        },
        "model_id": {
          "type": "integer",
          "minimum": 0,
          "maximum": 4294967295
        },
        "physical_memory_mib": {
          "type": "integer",
          "minimum": 1
        },
        "available_memory_mib": {
          "type": "integer",
          "minimum": 0
        },
        "isa": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "sse2",
            "sse4_2",
            "avx_hardware",
            "osxsave",
            "avx_usable",
            "avx2_usable",
            "avx512f_usable",
            "aes",
            "fma_usable",
            "virtualization"
          ],
          "properties": {
            "sse2": {
              "type": "boolean"
            },
            "sse4_2": {
              "type": "boolean"
            },
            "avx_hardware": {
              "type": "boolean"
            },
            "osxsave": {
              "type": "boolean"
            },
            "avx_usable": {
              "type": "boolean"
            },
            "avx2_usable": {
              "type": "boolean"
            },
            "avx512f_usable": {
              "type": "boolean"
            },
            "aes": {
              "type": "boolean"
            },
            "fma_usable": {
              "type": "boolean"
            },
            "virtualization": {
              "type": "boolean"
            }
          }
        }
      }
    },
    "suite": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema",
        "repeat",
        "warmup_runs",
        "measured_runs",
        "runs",
        "statistics",
        "timing_note"
      ],
      "properties": {
        "schema": {
          "const": "pytyliki.suite.v1"
        },
        "repeat": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100
        },
        "warmup_runs": {
          "type": "integer",
          "minimum": 0,
          "maximum": 99
        },
        "measured_runs": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100
        },
        "runs": {
          "type": "array",
          "minItems": 1,
          "maxItems": 100,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "run",
              "warmup",
              "iterations",
              "memory_mib",
              "passes",
              "integer_ms",
              "memory_ms",
              "matrix_ms",
              "checksum",
              "integrity_ok"
            ],
            "properties": {
              "run": {
                "type": "integer",
                "minimum": 1,
                "maximum": 100
              },
              "warmup": {
                "type": "boolean"
              },
              "iterations": {
                "type": "integer",
                "minimum": 1
              },
              "memory_mib": {
                "type": "integer",
                "minimum": 1,
                "maximum": 64
              },
              "passes": {
                "type": "integer",
                "minimum": 1,
                "maximum": 32
              },
              "integer_ms": {
                "type": "number",
                "minimum": 0
              },
              "memory_ms": {
                "type": "number",
                "minimum": 0
              },
              "matrix_ms": {
                "type": "number",
                "minimum": 0
              },
              "checksum": {
                "type": "integer",
                "minimum": 0
              },
              "integrity_ok": {
                "type": "boolean"
              }
            }
          }
        },
        "statistics": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "integer_ms",
            "memory_ms",
            "matrix_ms"
          ],
          "properties": {
            "integer_ms": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "minimum",
                "maximum",
                "mean",
                "median",
                "sample_stddev",
                "coefficient_of_variation"
              ],
              "properties": {
                "minimum": {
                  "type": "number",
                  "minimum": 0
                },
                "maximum": {
                  "type": "number",
                  "minimum": 0
                },
                "mean": {
                  "type": "number",
                  "minimum": 0
                },
                "median": {
                  "type": "number",
                  "minimum": 0
                },
                "sample_stddev": {
                  "type": "number",
                  "minimum": 0
                },
                "coefficient_of_variation": {
                  "type": "number",
                  "minimum": 0
                }
              }
            },
            "memory_ms": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "mean",
                "median"
              ],
              "properties": {
                "mean": {
                  "type": "number",
                  "minimum": 0
                },
                "median": {
                  "type": "number",
                  "minimum": 0
                }
              }
            },
            "matrix_ms": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "mean",
                "median"
              ],
              "properties": {
                "mean": {
                  "type": "number",
                  "minimum": 0
                },
                "median": {
                  "type": "number",
                  "minimum": 0
                }
              }
            }
          }
        },
        "timing_note": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        }
      }
    }
  }
}
