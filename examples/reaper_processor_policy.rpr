# Pytyliki processor policy v1.
# CI-only Reaper contract. All samples below are fixtures, never live CPU telemetry.

make PROCESSOR_POLICY_SCHEMA := "pytyliki.processor-policy.v1"

craft processor_snapshot_valid(snapshot) {
    # [schema, snapshot_id, architecture, vendor, packages, dies, cores, logical_threads, online_threads, generation, features, source]
    when kind(snapshot) != "list" or size(snapshot) != 12 { yield false }
    when snapshot[0] != "pytyliki.processor-snapshot.v1" { yield false }
    when kind(snapshot[1]) != "text" or size(snapshot[1]) == 0 { yield false }
    when kind(snapshot[2]) != "text" or kind(snapshot[3]) != "text" { yield false }
    when snapshot[4] <= 0 or snapshot[5] <= 0 or snapshot[6] <= 0 { yield false }
    when snapshot[7] < snapshot[6] or snapshot[8] < 0 or snapshot[8] > snapshot[7] { yield false }
    when snapshot[9] < 0 or kind(snapshot[10]) != "list" or kind(snapshot[11]) != "text" { yield false }
    yield true
}

craft core_descriptor_valid(core, core_count, logical_count) {
    # [core_id, package_id, die_id, class, state, online, logical_ids, generation]
    when kind(core) != "list" or size(core) != 8 { yield false }
    when core[0] < 0 or core[0] >= core_count or core[1] < 0 or core[2] < 0 { yield false }
    when core[3] != "performance" and core[3] != "efficiency" and core[3] != "general" and core[3] != "unknown" { yield false }
    when core[4] != "online" and core[4] != "offline" and core[4] != "starting" and core[4] != "quarantined" and core[4] != "failed" { yield false }
    when kind(core[6]) != "list" or core[7] < 0 { yield false }
    when core[5] and (core[4] != "online" or size(core[6]) == 0) { yield false }
    when not core[5] and size(core[6]) != 0 { yield false }
    each logical_id in core[6] {
        when logical_id < 0 or logical_id >= logical_count { yield false }
    }
    yield true
}

craft topology_valid(cores, expected_core_count, logical_count) {
    when kind(cores) != "list" or size(cores) != expected_core_count or expected_core_count <= 0 { yield false }
    vary identifiers := []
    each core in cores {
        when not core_descriptor_valid(core, expected_core_count, logical_count) { yield false }
        change identifiers := push(identifiers, core[0])
    }
    yield size(unique(identifiers)) == expected_core_count
}

craft affinity_valid(affinity, logical_count) {
    when kind(affinity) != "list" or size(affinity) == 0 or logical_count <= 0 { yield false }
    each cpu_id in affinity {
        when cpu_id < 0 or cpu_id >= logical_count or cpu_id % 1 != 0 { yield false }
    }
    yield size(unique(affinity)) == size(affinity)
}

craft split_work(total_items, worker_count) {
    when total_items < 0 or worker_count <= 0 or total_items % 1 != 0 or worker_count % 1 != 0 { yield [] }
    make base_size := total_items // worker_count
    make remainder := total_items % worker_count
    vary allocations := []
    each worker in range(0, worker_count) {
        vary assigned := base_size
        when worker < remainder { change assigned := assigned + 1 }
        change allocations := push(allocations, assigned)
    }
    yield allocations
}

craft metric_evidence_valid(metric) {
    # [provider, metric_id, unit, value, minimum, maximum, sample_count, workload_id, captured_at, mode]
    when kind(metric) != "list" or size(metric) != 10 { yield false }
    when kind(metric[0]) != "text" or kind(metric[1]) != "text" or kind(metric[2]) != "text" { yield false }
    when kind(metric[3]) != "number" or kind(metric[4]) != "number" or kind(metric[5]) != "number" or kind(metric[6]) != "number" { yield false }
    when kind(metric[7]) != "text" or kind(metric[8]) != "text" or kind(metric[9]) != "text" { yield false }
    when size(metric[0]) == 0 or size(metric[1]) == 0 or size(metric[2]) == 0 or size(metric[7]) == 0 or size(metric[8]) == 0 { yield false }
    when metric[4] > metric[5] or metric[3] < metric[4] or metric[3] > metric[5] { yield false }
    when metric[6] <= 0 or metric[6] > 1000000 or metric[6] % 1 != 0 { yield false }
    when metric[9] != "fixture" and metric[9] != "local-read-only" { yield false }
    yield true
}

craft metrics_comparable(left, right) {
    when not metric_evidence_valid(left) or not metric_evidence_valid(right) { yield false }
    yield left[0] == right[0] and left[1] == right[1] and left[2] == right[2] and left[7] == right[7] and left[9] == right[9]
}

craft verification_evidence_valid(evidence) {
    # [revision_id, total, passed, failed, coverage_basis_points, duration_ms, artifact_sha256, verifier]
    when kind(evidence) != "list" or size(evidence) != 8 { yield false }
    when kind(evidence[0]) != "text" or size(evidence[0]) == 0 { yield false }
    when evidence[1] <= 0 or evidence[2] < 0 or evidence[3] < 0 { yield false }
    when evidence[2] + evidence[3] != evidence[1] or evidence[3] != 0 { yield false }
    when evidence[4] < 0 or evidence[4] > 10000 or evidence[5] <= 0 { yield false }
    when kind(evidence[6]) != "text" or size(evidence[6]) != 64 or kind(evidence[7]) != "text" or size(evidence[7]) == 0 { yield false }
    yield true
}

craft revision_valid(revision) {
    # [component, major, minor, patch, parent, source_sha256, abi_major, generation, state]
    when kind(revision) != "list" or size(revision) != 9 { yield false }
    when kind(revision[0]) != "text" or size(revision[0]) == 0 { yield false }
    when revision[1] < 0 or revision[2] < 0 or revision[3] < 0 or revision[6] <= 0 or revision[7] < 0 { yield false }
    when kind(revision[4]) != "text" or kind(revision[5]) != "text" or size(revision[5]) != 64 { yield false }
    when revision[8] != "draft" and revision[8] != "verified" and revision[8] != "staged" and revision[8] != "active" and revision[8] != "retired" and revision[8] != "rejected" { yield false }
    yield true
}

craft live_change_admission(active, candidate, evidence, quiescent, rollback_ready, signature_valid, abi_compatible) {
    when not revision_valid(active) or not revision_valid(candidate) { yield "reject-revision" }
    when active[8] != "active" or candidate[8] != "staged" { yield "reject-state" }
    when active[0] != candidate[0] or candidate[7] != active[7] + 1 { yield "reject-generation" }
    when active[6] != candidate[6] or not abi_compatible { yield "reject-abi" }
    when not verification_evidence_valid(evidence) or evidence[0] != candidate[0] { yield "reject-evidence" }
    when not signature_valid { yield "reject-signature" }
    when not quiescent { yield "defer-quiescence" }
    when not rollback_ready { yield "reject-rollback" }
    yield "admit-policy-rehearsal"
}

craft operation_admission(request) {
    # [operation, source, target, bounded, user_requested, capability]
    when kind(request) != "list" or size(request) != 6 { yield "reject-shape" }
    when request[0] == "inventory" or request[0] == "measure" or request[0] == "profile" or request[0] == "analyze" or request[0] == "compare" or request[0] == "export-report" {
        when not request[3] { yield "reject-unbounded-operation" }
        yield "admit-read-only"
    }
    yield "reject-native-control-out-of-scope"
}
