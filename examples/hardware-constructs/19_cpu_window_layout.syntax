memory_map cpu_window_layout for target("example-board") {
    region REG_MIRROR {
        base: 0x1000_0000;
        size: 4_KiB;
        permissions: [read, write];
        memory_type: device;
    }

    region OVERLAY_LOG {
        base: 0x1000_1000;
        size: 16_KiB;
        permissions: [read, write];
        memory_type: uncached;
    }

    region SNAP_STORE {
        base: 0x1000_5000;
        size: 64_KiB;
        permissions: [read, write];
        memory_type: dma_coherent;
    }
}

