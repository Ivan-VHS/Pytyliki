# Reaper-side silicon contract for Pytyliki silicon-runtime v1.
# This declares a reference Cortex-M4 profile; it never touches physical hardware.

let silicon_profile = {
    "schema": "pytyliki.silicon-profile.v1",
    "runtime_abi": "0x00010000",
    "targets": ["arm-cortex-m", "riscv32", "x86", "x86_64"],
    "cycle_sources": {
        "arm-cortex-m": "DWT_CYCCNT (opt-in)",
        "riscv32": "rdcycle (privilege-gated)",
        "x86": "RDTSC (TSC ticks)",
        "x86_64": "RDTSC (TSC ticks)"
    },
    "reference_cortex_m4": {
        "architecture": "ARMv7E-M",
        "isa": "Thumb-2 (v1 verifier accepts Thumb-16 only)",
        "cycle_register": "DWT_CYCCNT",
        "kernel_states": ["RESET_BOOT", "STANDBY_WFI", "RUN_HOT", "SLOWMO_TRACE", "FAULT_LOCK", "SAFE_HALT"],
        "guards": ["barriers_enforced", "alignment_strict", "watchdog_alive"],
        "mmio": [
            {"name": "RCC_AHB1ENR", "address": "0x40023830", "width_bits": 32, "barrier": "dsb", "access": "board-defined"},
            {"name": "GPIOA_ODR", "address": "0x40020014", "width_bits": 32, "barrier": "dmb", "access": "board-defined"},
            {"name": "SCB_ICSR", "address": "0xE000ED04", "width_bits": 32, "barrier": "isb", "access": "board-defined"}
        ],
        "traps": [
            {"name": "HardFault", "vector": 3, "pain_weight": 180, "slowmo_at_cycles": 600},
            {"name": "BusFault", "vector": 5, "pain_weight": 120, "slowmo_at_cycles": 600},
            {"name": "SysTick", "vector": 15, "pain_weight": 15, "slowmo_at_cycles": 600}
        ],
        "isa_stream": {"name": "patch_bay_code", "word_bits": 16, "exec_mode": "verify_only"},
        "threads": [
            {"name": "cpu_pulse_t", "core": 0, "priority": 2, "quota_cycles": 1200, "breath_cycles": 300},
            {"name": "cpu_guard_t", "core": 0, "priority": 1, "quota_cycles": 800, "breath_cycles": 400}
        ]
    },
    "native_execution": false,
    "mmio": {
        "default_enabled": false,
        "requires_exact_allowlist": true,
        "requires_board_hal": true
    },
    "machine_code": {
        "default_mode": "verify_only",
        "thumb16_whitelist": true,
        "rv32i_whitelist": true,
        "x86_decoder": false,
        "jit_trampoline": false
    },
    "fault_trace": {
        "ring": "bounded-spsc",
        "overflow": "drop-newest",
        "isr_logging": false
    },
    "patching": {
        "staging_only": true,
        "crc": "crc16-ccitt",
        "crc_authenticates": false,
        "flash_write": false,
        "execute_payload": false
    }
}

assert(silicon_profile.schema == "pytyliki.silicon-profile.v1", "silicon profile schema mismatch")
assert(silicon_profile.runtime_abi == "0x00010000", "silicon ABI mismatch")
assert(size(silicon_profile.targets) == 4, "target matrix mismatch")
assert(size(silicon_profile.reference_cortex_m4.kernel_states) == 6, "state matrix mismatch")
assert(size(silicon_profile.reference_cortex_m4.mmio) == 3, "reference MMIO matrix mismatch")
assert(size(silicon_profile.reference_cortex_m4.traps) == 3, "fault vector matrix mismatch")
assert(size(silicon_profile.reference_cortex_m4.threads) == 2, "CPU thread budget matrix mismatch")
assert(silicon_profile.reference_cortex_m4.isa_stream.exec_mode == "verify_only", "machine stream must be verification-only")
assert(silicon_profile.native_execution == false, "native execution must remain disabled")
assert(silicon_profile.mmio.requires_exact_allowlist == true, "MMIO allowlist is mandatory")
assert(silicon_profile.machine_code.default_mode == "verify_only", "verification-only must be default")
assert(silicon_profile.machine_code.jit_trampoline == false, "JIT trampoline must remain disabled")
assert(silicon_profile.patching.crc_authenticates == false, "CRC must not be treated as authentication")
assert(silicon_profile.patching.flash_write == false, "generic patcher must not write Flash")

write_json("build/reaper-silicon-profile.json", silicon_profile)
emit "Pytyliki silicon-runtime contract: PASS"
emit silicon_profile
