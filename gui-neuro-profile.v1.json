{
  "schema": "dak.gui-neuro-profile.v1",
  "version": 1,
  "repository": "Ivan-VHS/Pytyliki",
  "ui_stack": [
    "C11 core",
    "Win32 native desktop UI",
    "Portable CLI"
  ],
  "primary_ui_surfaces": [
    "src/win_gui.c",
    "src/ui_ux_policy.h",
    "src/mora_theme.h",
    "tests/test_ui_ux_40026.c"
  ],
  "automation": {
    "agent_mode": "supervised-neuro-agent",
    "stages": [
      "observe",
      "measure",
      "diagnose",
      "propose",
      "sandbox",
      "validate",
      "feature-branch",
      "human-review"
    ],
    "target_branch_policy": "feature-branch-only",
    "human_review_required": true,
    "allow_main_branch_writes": false,
    "allow_auto_merge": false,
    "model_runtime": "operator-configured; not invoked by this workflow",
    "change_budget": {
      "max_files_per_pr": 20,
      "prefer_small_reviewable_changes": true,
      "require_rollback_plan": true
    }
  },
  "privacy": {
    "external_model_data": "deny_by_default",
    "telemetry": "disabled",
    "secret_access": "deny",
    "local_artifacts_only": true
  },
  "allowed_write_paths": [
    "gui-neuro-profile.v1.json",
    "docs/GUI_NEURO_AUTOIMPROVEMENT.md",
    "tools/validate_gui_neuro_profile.mjs",
    ".github/workflows/gui-neuro-profile.yml",
    "src/win_gui.c",
    "src/ui_ux_policy.h",
    "src/mora_theme.h",
    "tests/test_ui_ux_40026.c"
  ],
  "protected_write_paths": [
    "src/processor.c",
    "src/processor.h",
    "src/core.c",
    "src/hardware_inventory.c",
    "src/diagnostics_abi.c",
    "security/"
  ],
  "quality_gates": [
    "CMake build and CTest on Windows and Linux",
    "Win32 DPI, keyboard focus and sizing review",
    "C11 UI policy regression tests",
    "ASan/UBSan core tests remain green"
  ],
  "success_metrics": [
    "DPI-scaled logical dimensions without layout overflow",
    "WCAG contrast checks remain passing",
    "UI changes do not modify hardware discovery or measurement semantics",
    "resource handles are released on all paths"
  ],
  "implementation_boundary": "Pytyliki is a bounded C11 processor-systems workstation. The Win32 UI is Windows-only; keep portable CLI/core behavior intact. Hardware discovery remains read-only and UI code must not change measurement semantics."
}
