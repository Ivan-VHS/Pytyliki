  "not_claimed": [
    "Convolutional, recurrent, transformer or generative model execution",
    "GPU, accelerator, distributed training or network transport",
    "Model serialization, cryptographic signing or secure aggregation",
    "OS sandboxing, differential privacy or formal proof of model safety",
    "Cross-platform bitwise floating-point reproducibility"
  ],
  "safety_boundaries": [
    "The runtime is local and CPU-only; this contract adds no network client or telemetry path.",
    "All tensors, parameters and workspaces are supplied and owned by the caller; the runtime does not allocate or retain them.",
    "Model dimensions, parameter counts, layer counts, batch size and federation peer counts are bounded before execution.",
    "Training is opt-in through a versioned contract flag and each SGD step validates all candidate parameter updates before mutation.",
    "Ghostery is a policy admission gate, not an OS sandbox or a cryptographic privacy mechanism.",
    "SELITOL validates peer metadata and quorum only; it does not connect to peers or exchange model weights.",
    "A validated contract is not evidence that a model is accurate, unbiased or safe for high-stakes decisions."
  ]
