{
  "schema": "pytyliki.neuro-suite.v1",
  "version": 1,
  "repository": "Ivan-VHS/Pytyliki",
  "runtime": {
    "language": "C11",
    "numeric_type": "IEEE-754 binary64 double",
    "model_kind": "bounded dense feed-forward network",
    "weight_layout": "row-major [output_neuron][input_neuron]",
    "activations": [
      "linear",
      "relu",
      "tanh",
      "sigmoid"
    ],
    "memory_policy": "caller-owned fixed-capacity buffers; no runtime allocation",
    "execution_policy": "local CPU execution; no network, telemetry or dynamic code"
  },
  "limits": {
    "max_layers": 32,
    "max_neurons_per_layer": 4096,
    "max_parameters": 4194304,
    "max_batch": 1024,
    "max_peers": 32,
    "max_peer_id_ascii_bytes": 64,
    "max_learning_rate": 1
  },
