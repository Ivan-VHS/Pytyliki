  "contract_flags": [
    "allow_training",
    "allow_batch",
    "allow_federation"
  ],
  "implemented_features": [
    "Versioned framework registry and model/contract compatibility validation",
    "Dense feed-forward inference with bounded caller-owned ping-pong workspace",
    "Single-example SGD backpropagation with mean-squared-error loss and all-parameter preflight before mutation",
    "Row-major batch inference with explicit batch limits",
    "Privacy admission checks that reject external transfer, telemetry, input persistence, remote updates and dynamic code",
    "Peer manifest, ABI/version, uniqueness, framework and generation validation with quorum checks"
